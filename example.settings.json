// pi-gear-router 0.2 配置（JSONC）。
// 用户级：~/.pi/agent/pi-gear-router/settings.json
// 项目级：<项目根>/.pi/pi-gear-router/settings.json，仅在 Pi project trust 已确认时加载。
// 未指定字段继承，gears 按档位覆盖；旧模式／bands／observer／workflow 等字段忽略。
{
  // false 时不调用 Jev，沿用已有物理模型；无历史用 standard。
  "enabled": true,
  // 必须是 Pi 已配置且有凭据的物理模型；档位 thinking 按模型支持范围裁剪。
  "gears": {
    // light 只在 standard、heavy 不可用时兜底，不按简单消息主动选择。
    "light": { "provider": "yourprovider", "model": "fallback-model-id", "thinkingLevel": "low" },
    "standard": { "provider": "yourprovider", "model": "balanced-model-id", "thinkingLevel": "medium" },
    "heavy": { "provider": "yourprovider", "model": "frontier-model-id", "thinkingLevel": "high" }
  },
  // 仅首轮及进入实现调用；总超时包含最多两次传输重试。
  "judgeTimeoutMs": 15000
}
